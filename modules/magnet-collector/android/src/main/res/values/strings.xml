<?xml version="1.0" encoding="utf-8"?>
<!--
  The collect activity runs with no React context, so it cannot reach the app's
  i18n bundle (locales/*/translation.json). These are the only two strings in
  the app that have to be duplicated as Android resources.

  Translations sit in values-{fr,es,de,ru,zh}/strings.xml beside this file and
  Android picks by device locale on its own — the six must be kept in step by
  hand, since tests/locales/i18n-parity.test.ts only covers the JS bundle and
  cannot see these. Note the plural sets differ by language on purpose:
  Russian needs one/few/many/other, Chinese only other.
-->
<resources>
    <string name="magnet_already_collected">Already in the magnet basket</string>
    <plurals name="magnet_collected">
        <item quantity="one">%d magnet in the basket</item>
        <item quantity="other">%d magnets in the basket</item>
    </plurals>
</resources>
