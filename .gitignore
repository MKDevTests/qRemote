# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
ios/
!modules/**/ios/
android/
# Same exemption as ios/ above: the generated app-level android/ is ignored,
# but a local Expo module ships its own android/ source tree and MUST be
# committed -- without it the native side of modules/* is silently absent from
# a fresh clone and the module autolinks to nothing.
!modules/**/android/
# ...but never its Gradle output.
modules/**/android/build/
modules/**/android/.cxx/
# dependencies
node_modules/
key.json
# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# editor swap files
*.swp
*.swo

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test coverage
coverage/

# ios/ is committed as source of truth (bare React Native workflow) -- it is
# no longer regenerated by `expo prebuild`. Pods/, build/, xcuserdata, and
# other machine-local/derived paths are excluded by ios/.gitignore.

.audit/
